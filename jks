import calendar
def display_calendar(year):
    if 1800 <= year <= 2099:
        for month in range(1, 13):
            print(calendar.month_name[month], year)
            print(calendar.month(year, month))
    else:
        print("Please enter a year between 1800 and 2099.")
y=int(input("enter year (in four digit):"))
display_calendar(y)